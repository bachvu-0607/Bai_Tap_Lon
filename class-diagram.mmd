classDiagram
    direction TB

    %% =========================================================
    %% Domain base, users, wallet contracts
    %% =========================================================
    namespace DomainUsers {
        class Entity {
            <<abstract>>
            -String id
            -LocalDateTime createdAt
            -LocalDateTime updatedAt
            +Entity()
            +Entity(String)
            +getId() String
            +getCreatedAt() LocalDateTime
            +getUpdatedAt() LocalDateTime
        }

        class User {
            <<abstract>>
            -String userName
            -String name
            -String citizenId
            -String phoneNumber
            -String password
            -String address
            -boolean isActive
            +isActive() boolean
            +setActive(boolean)
            +getName() String
            +getCitizenId() String
            +getPhoneNumber() String
            +getAddress() String
        }

        class Admin {
            +banUser(User)
        }

        class Seller {
            -double balance
            +deposit(double)
            +getBalance() double
            +getAvailableBalance() double
        }

        class Bidder {
            +double DEFAULT_BALANCE
            -double balance
            -double lockedBalance
            -double maxBidLimit
            -boolean autoBidEnabled
            +restoreFunds(double, double)
            +enableAutoBid(double)
            +disableAutoBid()
            +lockFunds(double)
            +unlockFunds(double)
            +commitPayment(double)
            +canAfford(double) boolean
            +getAvailableBalance() double
        }

        class Payable {
            <<interface>>
            +deposit(double)
            +getBalance() double
            +getAvailableBalance() double
        }

        class Biddable {
            <<interface>>
            +lockFunds(double)
            +unlockFunds(double)
            +commitPayment(double)
            +canAfford(double) boolean
        }
    }

    %% =========================================================
    %% Items and factory pattern
    %% =========================================================
    namespace ItemModel {
        class Item {
            <<abstract>>
            -String name
            -String description
            -String imageLink
            -double startingPrice
            -ItemStatus status
            +getCategory() String
            +isValid() boolean
            +getImageLink() String
            +setImageLink(String)
            +setStatus(ItemStatus)
        }

        class Electronics {
            -String brand
            -String model
            +getCategory() String
        }

        class Art {
            -String artist
            -int yearCreated
            -String medium
            +getCategory() String
        }

        class Vehicle {
            -String manufacturer
            -int yearMade
            +getCategory() String
        }

        class ItemFactory {
            <<abstract>>
            +createItem(String, double) Item
            +createItembyId(String, String, double) Item
        }

        class ElectronicsFactory {
            +createItem(String, double) Item
            +createItembyId(String, String, double) Item
        }

        class ArtFactory {
            +createItem(String, double) Item
            +createItembyId(String, String, double) Item
        }

        class VehicleFactory {
            +createItem(String, double) Item
            +createItembyId(String, String, double) Item
        }

        class ItemStatus {
            <<enumeration>>
            AVAILABLE
            IN_AUCTION
            SOLD
            REMOVED
        }

        class ItemType {
            <<enumeration>>
            ELECTRONICS
            ART
            VEHICLE
        }
    }

    %% =========================================================
    %% Auction domain, observer, bidding and anti-sniping
    %% =========================================================
    namespace AuctionCore {
        class Auction {
            -Item item
            -Seller seller
            -LocalDateTime startTime
            -LocalDateTime endTime
            -double currentMaxPrice
            -double minIncrement
            -Bidder winner
            -AuctionStatus status
            -List historyBids
            -List observers
            +updateStatus() boolean
            +validateBid(double)
            +placeBid(Bidder, double)
            +cancelBidderParticipation(String) boolean
            +cancelBecauseSellerBanned() boolean
            +extendEndTime(long)
            +extendEndTimeIfCloseToEnd(long, long) boolean
            +confirmPayment()
            +addObserver(AuctionObserver)
            +removeObserver(AuctionObserver)
            +notifyUpdated()
            +setStatus(AuctionStatus)
            +getMinimumNextBid() double
        }

        class BidTransaction {
            -Bidder bidder
            -double bidAmount
            -LocalDateTime time
            -BidStatus status
            +isValid() boolean
            +setStatus(BidStatus)
            +getBidder() Bidder
            +getBidAmount() double
        }

        class AuctionObserver {
            <<interface>>
            +update(Auction)
        }

        class AuctionStatus {
            <<enumeration>>
            PENDING_APPROVAL
            REJECTED
            OPEN
            RUNNING
            FINISHED
            PAID
            CANCELED
        }

        class BidStatus {
            <<enumeration>>
            WINNING
            OUTBID
            PAID
            CANCELED
        }
    }

    %% =========================================================
    %% Socket DTO: request, result, summary and realtime event
    %% =========================================================
    namespace SocketDTO {
        class AuctionRequest {
            -RequestType type
            -Object data
            +AuctionRequest(RequestType, Object)
            +getType() RequestType
            +getData() Object
        }

        class RequestType {
            <<enumeration>>
            SIGN_IN
            REGISTER
            SIGN_OUT
            BID
            GET_LIST
            GET_USERS
            GET_ONLINE_USERS
            GET_BID_HISTORY
            GET_PENDING_AUCTIONS
            GET_SELLER_PRODUCTS
            APPROVE_AUCTION
            REJECT_AUCTION
            POST_PRODUCT
            SET_AUTO_BID
            DISABLE_AUTO_BID
            DISCONNECT
            BAN_USER
        }

        class SignInRequest {
            -String username
            -String password
        }

        class RegisterRequest {
            -String name
            -String phone
            -String citizenId
            -String password
            -String address
            -String role
        }

        class ProductPostRequest {
            -String productType
            -String productName
            -String description
            -double openingPrice
            -double minIncrement
            -LocalDateTime startTime
            -LocalDateTime endTime
            -String imageLink
        }

        class BidRequest {
            -String auctionId
            -double amount
        }

        class AutoBidRequest {
            -String auctionId
            -double maxBidLimit
        }

        class AuctionApprovalRequest {
            -String auctionId
        }

        class ServerEvent {
            -ServerEventType type
            -Object data
            +getType() ServerEventType
            +getData() Object
        }

        class ServerEventType {
            <<enumeration>>
            AUCTION_UPDATED
            ONLINE_USERS_UPDATED
            USER_BANNED
        }

        class AuctionSummary {
            -String auctionId
            -String itemName
            -String description
            -String category
            -String sellerName
            -String currentWinnerName
            -String imageLink
            -double currentPrice
            -double minIncrement
            -double minimumNextBid
            -String status
            -LocalDateTime startTime
            -LocalDateTime endTime
            +AuctionSummary(Auction)
        }

        class BidHistoryPoint {
            -String bidderName
            -double amount
            -LocalDateTime bidTime
            -String status
            +BidHistoryPoint(BidTransaction)
        }

        class UserSummary {
            -String systemId
            -String name
            -String phone
            -String role
            -boolean active
            +getStatusText() String
        }

        class AuthenticationResult {
            -boolean success
            -User user
            -String errorCode
            +success(User) AuthenticationResult
            +failed(String) AuthenticationResult
        }

        class BidResult {
            -boolean success
            -String message
            +success(String) BidResult
            +failed(String) BidResult
        }

        class AuctionActionResult {
            -boolean success
            -String message
            +success(String) AuctionActionResult
            +failed(String) AuctionActionResult
        }

        class ProductPostResult {
            -boolean success
            -String message
            +success(String) ProductPostResult
            +failed(String) ProductPostResult
        }

        class UserActionResult {
            -boolean success
            -String message
            +success(String) UserActionResult
            +failed(String) UserActionResult
        }
    }

    %% =========================================================
    %% Server layer: business services, repositories and socket handler
    %% =========================================================
    namespace ServerLayer {
        class AuctionServer {
            +main(String[])
            -setupLogging()
        }

        class ClientHandler {
            -Socket clientSocket
            -AuthenticationService authenticationService
            -AuctionManager auctionManager
            -User currentUser
            -ObjectOutputStream out
            -ObjectInputStream in
            +run()
            +sendEvent(ServerEvent)
            +disconnectBecauseBanned(String)
            +getCurrentUserId() String
        }

        class AuctionManager {
            <<Singleton>>
            -static AuctionManager instance
            -List auctions
            -Map onlineClients
            -Map autoBidSettings
            -RealtimeAuctionNotifier realtimeNotifier
            -ScheduledExecutorService statusScheduler
            +getInstance() AuctionManager
            +signIn(String, ClientHandler) boolean
            +removeUser(String)
            +removeClient(ClientHandler)
            +getOnlineUsers() int
            +getUserSummaries() List
            +banUser(String, String) UserActionResult
            +broadcast(ServerEvent)
            +postProduct(ProductPostRequest, Seller) Auction
            +loadAuctionsFromDatabase()
            +getActiveAuctionSummaries() List
            +getPendingAuctionSummaries() List
            +getSellerAuctionSummaries(Seller) List
            +getBidListFromDatabase(String) List
            +approveAuction(String)
            +rejectAuction(String)
            +placeBid(String, Bidder, double)
            +setAutoBid(String, Bidder, double)
            +disableAutoBid(String, Bidder)
            +closeExpiredAuctions()
            +startStatusScheduler()
        }

        class AutoBidRegistration {
            -Bidder bidder
            -double maxBidLimit
        }

        class RealtimeAuctionNotifier {
            -AuctionManager auctionManager
            +update(Auction)
        }

        class AuthenticationService {
            +login(String, String) AuthenticationResult
            +register(String, String, String, String, String, String) AuthenticationResult
            +logout(String)
        }

        class AuctionRepository {
            +saveAuction(Auction, String)
            +loadAuctions() List
            +loadBidHistory(String) List
            +updateAuction(Auction)
            +saveBid(String, BidTransaction)
            +updateBid(BidTransaction)
            +cancelUserOpenBids(String)
            +cancelAuctionBids(String)
        }

        class UserRepository {
            +register() RegisterStatus
            +checkSignIn(String, String) User
            +findSellerBySystemId(String) Seller
            +findBidderBySystemId(String) Bidder
            +findAllUserSummaries() List
            +findUserSummaryBySystemId(String) UserSummary
            +banUser(String) boolean
            +updateBidderFunds(Bidder)
            +rebuildBidderLockedBalancesFromAuctions()
        }

        class DatabaseConnection {
            +getConnection() Connection
            +createTableUsers()
            +createAuctionTables()
        }
    }

    %% =========================================================
    %% Client layer: JavaFX controller, session, socket and data loader
    %% =========================================================
    namespace ClientLayer {
        class MainClient {
            +start(Stage)
            +main(String[])
        }

        class ClientSocket {
            -static Socket socket
            -static ObjectOutputStream out
            -static ObjectInputStream in
            -static BlockingQueue responseQueue
            -static Set eventListeners
            -static Thread listenerThread
            +connect()
            +addEventListener(Consumer)
            +removeEventListener(Consumer)
            +sendSignIn(String, String) AuthenticationResult
            +sendRegister() AuthenticationResult
            +getAuctionList() List
            +getOnlineUsers() int
            +getUserList() List
            +getPendingAuctionList() List
            +getSellerProductList() List
            +getHistoryBidList(String) List
            +approveAuction(String) AuctionActionResult
            +rejectAuction(String) AuctionActionResult
            +sendBid(String, double) BidResult
            +setAutoBid(String, double) BidResult
            +disableAutoBid(String) BidResult
            +postProduct() ProductPostResult
            +banUser(String) UserActionResult
            +sendDisconnect()
            -listenToServer()
            -notifyEventListeners(ServerEvent)
        }

        class SessionManager {
            +static User currentUser
            +clearSession()
            +isLoggedIn() boolean
        }

        class SceneManager {
            +switchScene(Node, String, String, int, int)
        }

        class MessageHelper {
            +showMessage(Label, String)
            +showError(Label, String)
            +clearMessage(Label)
        }

        class AddressDataLoader {
            +getProvinces() List
            +getCommunes() List
            +getCommunesByProvince(String) List
        }

        class Province {
            -String code
            -String name
        }

        class Commune {
            -String code
            -String name
            -String provinceCode
        }

        class SignInController
        class RegisterController
        class BidderHomeController
        class SellerHomeController
        class AdminHomeController
        class HomeController
        class AuctionListController
        class MyProductController
        class PostProductController
        class OrdersController
        class WalletController
        class MainViewController
    }

    %% =========================================================
    %% Exceptions
    %% =========================================================
    namespace DomainExceptions {
        class InvalidBidException
        class InsufficientBalanceException
        class InvalidTransactionException
        class InvalidDepositException
        class InvalidAdminActionException
    }

    %% =========================================================
    %% Inheritance and implementations
    %% =========================================================
    Entity <|-- User
    Entity <|-- Item
    Entity <|-- Auction
    Entity <|-- BidTransaction

    User <|-- Admin
    User <|-- Seller
    User <|-- Bidder
    Payable <|.. Seller
    Payable <|.. Bidder
    Biddable <|.. Bidder

    Item <|-- Electronics
    Item <|-- Art
    Item <|-- Vehicle
    ItemFactory <|-- ElectronicsFactory
    ItemFactory <|-- ArtFactory
    ItemFactory <|-- VehicleFactory

    AuctionObserver <|.. RealtimeAuctionNotifier

    %% =========================================================
    %% Domain relationships
    %% =========================================================
    Item --> ItemStatus : status
    Auction --> AuctionStatus : status
    BidTransaction --> BidStatus : status

    Auction "1" *-- "1" Item : item
    Auction "1" --> "1" Seller : seller
    Auction "1" --> "0..1" Bidder : winner
    Auction "1" *-- "0..*" BidTransaction : history
    Auction "1" o-- "0..*" AuctionObserver : observers
    BidTransaction "0..*" --> "1" Bidder : bidder

    ElectronicsFactory ..> Electronics : creates
    ArtFactory ..> Art : creates
    VehicleFactory ..> Vehicle : creates

    %% =========================================================
    %% DTO relationships
    %% =========================================================
    AuctionRequest --> RequestType : type
    AuctionRequest o-- SignInRequest : data
    AuctionRequest o-- RegisterRequest : data
    AuctionRequest o-- ProductPostRequest : data
    AuctionRequest o-- BidRequest : data
    AuctionRequest o-- AutoBidRequest : data
    AuctionRequest o-- AuctionApprovalRequest : data
    ServerEvent --> ServerEventType : type
    ServerEvent o-- AuctionSummary : auction data
    ServerEvent o-- UserSummary : user data
    AuctionSummary ..> Auction : snapshot
    BidHistoryPoint ..> BidTransaction : snapshot
    UserSummary ..> User : snapshot
    AuthenticationResult ..> User : carries user

    %% =========================================================
    %% Server relationships
    %% =========================================================
    AuctionServer ..> DatabaseConnection : init database
    AuctionServer ..> UserRepository : seed demo users
    AuctionServer ..> AuctionManager : load and schedule
    AuctionServer ..> ClientHandler : creates per socket

    ClientHandler ..> AuctionRequest : reads
    ClientHandler ..> AuthenticationService : authenticates
    ClientHandler ..> AuctionManager : business actions
    ClientHandler ..> ServerEvent : sends async event
    ClientHandler ..> AuthenticationResult : response
    ClientHandler ..> BidResult : response
    ClientHandler ..> AuctionActionResult : response
    ClientHandler ..> ProductPostResult : response
    ClientHandler ..> UserActionResult : response

    AuthenticationService ..> UserRepository : checks credentials
    AuthenticationService ..> AuctionManager : logout online map

    AuctionManager "1" o-- "0..*" Auction : manages
    AuctionManager "1" o-- "0..*" ClientHandler : online clients
    AuctionManager "1" o-- "0..*" AutoBidRegistration : auto bid settings
    AuctionManager *-- RealtimeAuctionNotifier : notifier
    AuctionManager ..> AuctionRepository : persists auctions
    AuctionManager ..> UserRepository : persists users and funds
    AuctionManager ..> ItemFactory : creates item by type
    AuctionManager ..> ServerEvent : broadcasts
    AuctionManager ..> AuctionSummary : builds list
    AuctionManager ..> BidHistoryPoint : builds chart data
    AuctionManager ..> UserSummary : admin user table

    RealtimeAuctionNotifier ..> ServerEvent : creates AUCTION_UPDATED
    RealtimeAuctionNotifier ..> AuctionSummary : builds payload
    RealtimeAuctionNotifier ..> AuctionManager : broadcast

    AuctionRepository ..> DatabaseConnection : uses
    AuctionRepository ..> UserRepository : restore bidder seller
    AuctionRepository ..> ItemFactory : restore item
    AuctionRepository ..> BidHistoryPoint : load history
    UserRepository ..> DatabaseConnection : uses

    Auction ..> InvalidBidException : throws
    Auction ..> InvalidTransactionException : throws
    Auction ..> InsufficientBalanceException : throws
    Bidder ..> InvalidDepositException : throws
    Admin ..> InvalidAdminActionException : throws

    %% =========================================================
    %% Client relationships
    %% =========================================================
    MainClient ..> ClientSocket : connect
    MainClient ..> SessionManager : close request

    ClientSocket ..> AuctionRequest : sends request
    ClientSocket ..> ServerEvent : listens event
    ClientSocket ..> AuthenticationResult : reads response
    ClientSocket ..> BidResult : reads response
    ClientSocket ..> ProductPostResult : reads response
    ClientSocket ..> AuctionSummary : receives
    ClientSocket ..> BidHistoryPoint : receives
    ClientSocket ..> UserSummary : receives
    ClientSocket ..> SessionManager : clears on disconnect

    SignInController ..> ClientSocket : sign in
    SignInController ..> SessionManager : save current user
    SignInController ..> SceneManager : navigate
    SignInController ..> MessageHelper : message

    RegisterController ..> ClientSocket : register
    RegisterController ..> AddressDataLoader : address data
    RegisterController ..> SceneManager : navigate
    RegisterController ..> MessageHelper : message

    BidderHomeController ..> ClientSocket : navigation and events
    SellerHomeController ..> ClientSocket : navigation and events
    AdminHomeController ..> ClientSocket : approval and ban
    HomeController ..> ClientSocket : online users
    AuctionListController ..> ClientSocket : bid auto bid realtime
    AuctionListController ..> AuctionSummary : table detail
    AuctionListController ..> BidHistoryPoint : chart history
    MyProductController ..> ClientSocket : seller products
    PostProductController ..> ClientSocket : post product
    WalletController ..> SessionManager : wallet data
    OrdersController ..> SessionManager : orders data

    AddressDataLoader --> Province : parses
    AddressDataLoader --> Commune : parses
