classDiagram
    direction LR

    class Entity {
        <<abstract>>
        #String id
        #LocalDateTime createdAt
        #LocalDateTime updatedAt
        +getId()
        +getCreatedAt()
        +getUpdatedAt()
    }

    class User {
        <<abstract>>
        -String userName
        -String name
        -String citizenId
        -String phoneNumber
        -String password
        -String address
        -boolean isActive
        +isActive()
        +setActive(boolean)
    }

    class Admin {
        +banUser(User)
        +forceCancelAuction(Auction)
    }

    class Seller {
        -List~Item~ soldProducts
        -double balance
        +deposit(double)
        +addSoldProduct(Item)
        +getSoldProducts()
    }

    class Bidder {
        -double balance
        -double lockedBalance
        -double maxBidLimit
        -boolean autoBidEnabled
        -List~BidTransaction~ bidHistory
        -List~Item~ placedProducts
        +deposit(double)
        +lockFunds(double)
        +unlockFunds(double)
        +commitPayment(double)
        +canAfford(double)
    }

    class Payable {
        <<interface>>
        +deposit(double)
        +getBalance()
        +getAvailableBalance()
    }

    class Biddable {
        <<interface>>
        +lockFunds(double)
        +unlockFunds(double)
        +commitPayment(double)
        +canAfford(double)
    }

    class Item {
        <<abstract>>
        -String name
        -String description
        -double startingPrice
        -ItemStatus status
        +getCategory()
        +getDescription()
        +isValid()
    }

    class Electronics {
        -String brand
        -String model
        +getCategory()
        +getDescription()
    }

    class Art {
        -String artist
        -int yearCreated
        -String medium
        +getCategory()
        +getDescription()
    }

    class Vehicle {
        -String manufacturer
        -int yearMade
        +getCategory()
        +getDescription()
    }

    class Auction {
        -Item item
        -Seller seller
        -LocalDateTime startTime
        -LocalDateTime endTime
        -double currentMaxPrice
        -List~BidTransaction~ historyBids
        -Bidder winner
        -double minIncrement
        -AuctionStatus status
        -List~AuctionObserver~ observers
        +updateStatus()
        +validateBid(double)
        +placeBid(Bidder, double)
        +confirmPayment()
    }

    class BidTransaction {
        -Bidder bidder
        -double bidAmount
        -LocalDateTime time
        -BidStatus status
        +isValid()
        +setStatus(BidStatus)
    }

    class AuctionObserver {
        <<interface>>
        +update(Auction)
    }

    class BidNotificationService {
        +update(Auction)
    }

    class PriceChartObserver {
        +update(Auction)
    }

    class AuctionManager {
        -static AuctionManager instance
        -List~String~ onlineUsers
        -List~Auction~ auctions
        +getInstance()
        +postProduct(ProductPostRequest, Seller)
        +approveAuction(String)
        +rejectAuction(String)
        +placeBid(String, Bidder, double)
        +closeExpiredAuctions()
    }

    class ItemFactory {
        +createItem(ItemType, String, String, double) Item
    }

    Entity <|-- User
    Entity <|-- Item
    Entity <|-- Auction
    Entity <|-- BidTransaction

    User <|-- Admin
    User <|-- Seller
    User <|-- Bidder

    Payable <|.. Seller
    Payable <|.. Bidder
    Biddable <|.. Bidder

    Item <|-- Electronics
    Item <|-- Art
    Item <|-- Vehicle

    Auction "1" *-- "1" Item : product
    Auction "1" --> "1" Seller : seller
    Auction "1" --> "0..1" Bidder : winner
    Auction "1" *-- "0..*" BidTransaction : history
    BidTransaction "0..*" --> "1" Bidder : bidder

    AuctionObserver <|.. BidNotificationService
    AuctionObserver <|.. PriceChartObserver
    Auction "1" o-- "0..*" AuctionObserver : observers

    AuctionManager "1" o-- "0..*" Auction : manages
    AuctionManager ..> ItemFactory : creates item
