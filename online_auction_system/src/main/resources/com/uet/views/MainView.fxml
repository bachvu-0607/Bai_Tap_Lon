<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Hyperlink?>

<VBox spacing="10.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.controllers.MainViewController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>
    <children>
        <Label styleClass="lbl_header" text="Main View" textFill="WHITE" />
        <Label text="Use Sign In to access the system." textFill="WHITE" />
        <Hyperlink fx:id="hpl_SignIn" onAction="#handleOpenSignInLink" text="Sign In" />
        <Hyperlink fx:id="hpl_Register" onAction="#handleOpenRegisterLink" text="Register" />
    </children>
</VBox>
