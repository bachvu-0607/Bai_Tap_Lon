<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="admin-root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.controllers.AdminHomeController">
    <content>
        <VBox spacing="12.0" styleClass="admin-content">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="nav-bar">
                    <children>
                        <Hyperlink onAction="#handleRefresh" text="Approval" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Admin" textFill="WHITE" />
                        <Hyperlink fx:id="hplSignOut" onAction="#handleSignOut" text="Sign Out" />
                    </children>
                </HBox>
                <Label styleClass="lbl_header" text="Admin Approval" textFill="WHITE" />
                <TableView fx:id="tblPendingAuctions" minHeight="220.0" prefHeight="260.0">
                    <columns>
                        <TableColumn fx:id="colItem" prefWidth="190.0" text="Item" />
                        <TableColumn fx:id="colCategory" prefWidth="130.0" text="Category" />
                        <TableColumn fx:id="colSeller" prefWidth="150.0" text="Seller" />
                        <TableColumn fx:id="colOpeningPrice" prefWidth="130.0" text="Opening Price" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                        <TableColumn fx:id="colEndTime" prefWidth="170.0" text="End Time" />
                    </columns>
                </TableView>
                <Label styleClass="lbl_header" text="User Management" textFill="WHITE" />
                <TableView fx:id="tblUsers" minHeight="220.0" prefHeight="280.0">
                    <columns>
                        <TableColumn fx:id="colUserId" prefWidth="230.0" text="System ID" />
                        <TableColumn fx:id="colUserName" prefWidth="170.0" text="Name" />
                        <TableColumn fx:id="colUserPhone" prefWidth="140.0" text="Phone" />
                        <TableColumn fx:id="colUserRole" prefWidth="120.0" text="Role" />
                        <TableColumn fx:id="colUserStatus" prefWidth="130.0" text="Status" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Button fx:id="btnApprove" onAction="#handleApprove" text="Approve" />
                        <Button fx:id="btnReject" onAction="#handleReject" text="Reject" />
                        <Button fx:id="btnBanUser" onAction="#handleBanUser" text="Ban User" />
                        <Button fx:id="btnRefresh" onAction="#handleRefresh" text="Refresh" />
                        <Label fx:id="lblMessage" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
