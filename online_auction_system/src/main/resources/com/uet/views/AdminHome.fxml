<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.client.controllers.AdminHomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="nav-bar">
            <children>
                <Hyperlink onAction="#handleRefresh" text="Approval" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Admin" textFill="WHITE" />
                <Hyperlink fx:id="hplSignOut" onAction="#handleSignOut" text="Sign Out" />
            </children>
        </HBox>
        <Label styleClass="lbl_header" text="Admin Approval" textFill="WHITE" />
        <TableView fx:id="tblPendingAuctions" minHeight="320.0" prefHeight="420.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colItem" prefWidth="190.0" text="Item" />
                <TableColumn fx:id="colCategory" prefWidth="130.0" text="Category" />
                <TableColumn fx:id="colSeller" prefWidth="150.0" text="Seller" />
                <TableColumn fx:id="colOpeningPrice" prefWidth="130.0" text="Opening Price" />
                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                <TableColumn fx:id="colEndTime" prefWidth="170.0" text="End Time" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button fx:id="btnApprove" onAction="#handleApprove" text="Approve" />
                <Button fx:id="btnReject" onAction="#handleReject" text="Reject" />
                <Button fx:id="btnRefresh" onAction="#handleRefresh" text="Refresh" />
                <Label fx:id="lblMessage" textFill="WHITE" />
            </children>
        </HBox>
    </children>
</VBox>
